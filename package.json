{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "arxiv-pro",
  "title": "arXiv",
  "description": "Search arXiv, save papers, and follow authors and topics",
  "icon": "arxiv-icon.png",
  "author": "ivan",
  "categories": [
    "Productivity",
    "Web"
  ],
  "license": "MIT",
  "preferences": [
    {
      "name": "downloadPath",
      "title": "PDF Download Path",
      "description": "Directory where PDFs will be saved",
      "type": "textfield",
      "default": "~/Downloads/Papers",
      "required": false
    },
    {
      "name": "autoOpenPDF",
      "title": "Auto Open PDFs",
      "description": "Automatically open PDFs after download",
      "type": "checkbox",
      "label": "Enable automatic PDF opening",
      "default": true,
      "required": false
    }
  ],
  "commands": [
    {
      "name": "search",
      "title": "Search Papers",
      "subtitle": "arXiv",
      "description": "Search papers by title, author, category, and date",
      "mode": "view",
      "icon": "arxiv-icon.png"
    },
    {
      "name": "bookmarks",
      "title": "Bookmarks",
      "subtitle": "arXiv",
      "description": "Read, annotate, and export saved papers",
      "mode": "view",
      "icon": "arxiv-icon.png"
    },
    {
      "name": "feedSelector",
      "title": "Browse Feeds",
      "subtitle": "arXiv",
      "description": "Browse recent papers from your subscriptions",
      "mode": "view",
      "icon": "arxiv-icon.png"
    },
    {
      "name": "subscriptions",
      "title": "Subscriptions",
      "subtitle": "arXiv",
      "description": "Follow categories, authors, and keywords",
      "mode": "view",
      "icon": "arxiv-icon.png"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.64.0",
    "@raycast/utils": "^1.10.1",
    "date-fns": "^3.0.0",
    "unicodeit": "^0.7.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/xml2js": "^0.4.14",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
